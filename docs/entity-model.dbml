Table surveys {
  survey_id varchar [pk]
  survey_name varchar
  source_columns_json text [note: 'JSON list of source-column classification and storage mappings']
}

Table sections {
  section_id varchar [pk]
  section_external_id varchar
  survey_id varchar [not null, ref: > surveys.survey_id]
}

Table question_catalog {
  question_catalog_id varchar [pk]
  normalized_question_content varchar [not null]
}

Table question_field_catalog {
  question_field_catalog_id varchar [pk]
  question_catalog_id varchar [not null, ref: > question_catalog.question_catalog_id]
  normalized_field_content varchar [not null]
}

Table questions {
  question_id varchar [pk]
  question_external_id varchar [not null]
  survey_id varchar [not null, ref: > surveys.survey_id]
  section_id varchar [ref: > sections.section_id]
  question_catalog_id varchar [not null, ref: > question_catalog.question_catalog_id]
  question_type varchar
  selector varchar
  sub_selector varchar
  canonical_question_type varchar [not null]
  answer_value_type varchar [not null]
}

Table answer_options {
  answer_option_id varchar [pk]
  answer_external_id varchar [not null]
  answer_id varchar [not null]
  answer_code varchar [not null]
  source_choice_id varchar [note: 'Native option ID; matrix scale answer ID, not statement row ID']
  choice_value text [note: 'Cleaned respondent-visible Display text']
  recode_value varchar [note: 'Explicit RecodeValues entry as text; null when not provided']
  variable_name text [note: 'Configured multiple-choice VariableNaming export label; null when unavailable']
  value text [note: 'Explicit recode when not null, otherwise choice_value; not a raw-value join key']
  answer_order integer [not null]
  answer_export_tag varchar
  source_import_id varchar
  question_id varchar [not null, ref: > questions.question_id]
  question_field_id varchar [not null, ref: > question_fields.question_field_id]
  field_id varchar [not null, ref: > question_fields.question_field_id]
  survey_id varchar [not null, ref: > surveys.survey_id]
  answer_text varchar
}

Table question_fields {
  question_field_id varchar [pk]
  field_external_id varchar [not null]
  choice_external_id varchar
  statement_text varchar
  import_external_id varchar
  survey_id varchar [not null, ref: > surveys.survey_id]
  question_id varchar [not null, ref: > questions.question_id]
  question_catalog_id varchar [not null, ref: > question_catalog.question_catalog_id]
  question_field_catalog_id varchar [not null, ref: > question_field_catalog.question_field_catalog_id]
  answer_value_type varchar [not null]
}

Table responses {
  Note: 'Additional response-property columns vary by survey. See surveys.source_columns_json for source names and storage mappings.'
  response_id varchar [pk]
  response_external_id varchar [not null]
  survey_id varchar [not null, ref: > surveys.survey_id]
  recorded_at varchar
}

Table response_answers {
  response_answer_id varchar [pk]
  survey_id varchar [not null, ref: > surveys.survey_id]
  response_id varchar [not null, ref: > responses.response_id]
  question_id varchar [not null, ref: > questions.question_id]
  question_catalog_id varchar [not null, ref: > question_catalog.question_catalog_id]
  question_field_id varchar [not null, ref: > question_fields.question_field_id]
  question_field_catalog_id varchar [not null, ref: > question_field_catalog.question_field_catalog_id]
  answer_option_id varchar [ref: > answer_options.answer_option_id]
  answer_text varchar [not null]
  raw_value text [note: 'Exact original nonempty CSV cell; unavailable in older entity folders']
  answer_numeric double
  answer_boolean boolean
  is_selected boolean
  answer_value_type varchar [not null]
}
